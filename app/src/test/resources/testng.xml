<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="openMRS Suite" thread-count="3" parallel="tests">
    <test name="Setup Test Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="openMRS.tests.SetupTest"/>
        </classes>
    </test>

    <test name="Setup Test Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="openMRS.tests.SetupTest"/>
        </classes>
    </test>

    <test name="Setup Test Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="openMRS.tests.SetupTest"/>
        </classes>
    </test>
</suite>
